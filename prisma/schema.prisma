  retentionPolicy      String?  @map("retention_policy") @db.Text
  crossBorderTransfers Boolean  @default(false) @map("cross_border_transfers")
  lawfulBasis          String?  @map("lawful_basis")

  buildType            AiRegisterBuildType @default(mixed) @map("build_type")
  vendor               String?
  modelProvider        String?             @map("model_provider")
  modelNameVersion     String?             @map("model_name_version")
  modelType            AISystemModelType   @default(llm) @map("model_type")
  hostingLocation      String?             @map("hosting_location")
  subprocessors        String?             @db.Text
  trainsOnCustomerData String?             @map("trains_on_customer_data")
  contractDpaStatus    String?             @map("contract_dpa_status")
  dependencies         String?             @db.Text

  regions         String[]         @default([])
  deploymentStage DeploymentStage  @default(idea) @map("deployment_stage")
  goLiveDate      DateTime?        @map("go_live_date")
  retirementDate  DateTime?        @map("retirement_date")
  lastReviewedAt  DateTime?        @map("last_reviewed_at")
  nextReviewAt    DateTime?        @map("next_review_at")
  shadowAi        Boolean          @default(false) @map("shadow_ai")
  nextAction      String?          @map("next_action") @db.Text

  riskTier             RiskTier?                     @map("risk_tier")
  riskSource           AiSystemRiskSource            @default(not_assessed) @map("risk_source")
  manualRiskRationale  String?                       @map("manual_risk_rationale") @db.Text
  riskAssessmentStatus AiSystemRiskAssessmentStatus  @default(not_started) @map("risk_assessment_status")
  inherentRiskTier     RiskTier?                     @map("inherent_risk_tier")
  residualRiskTier     RiskTier?                     @map("residual_risk_tier")
  inherentRiskScore    Float?                        @map("inherent_risk_score")
  residualRiskScore    Float?                        @map("residual_risk_score")
  riskSummary          String?                       @map("risk_summary") @db.Text
  keyRiskThemes        String[]                      @default([]) @map("key_risk_themes")
  treatmentPlan        String?                       @map("treatment_plan") @db.Text
  /// Canonical control codes accepted as key controls for this use case.
  keyControlCodes      String[]                      @default([]) @map("key_control_codes")

  /// Auto-determined assessment suite + module progress (privacy, FRIA, fairness, etc.).
  assessmentSuite Json? @map("assessment_suite")

  riskAcceptanceStatus   AiRegisterRiskAcceptanceStatus @default(not_required) @map("risk_acceptance_status")
  riskAcceptedBy         String?                        @map("risk_accepted_by")
  riskAcceptedByEmail    String?                        @map("risk_accepted_by_email")
  riskAcceptedAt         DateTime?                      @map("risk_accepted_at")
  riskAcceptanceNote     String?                        @map("risk_acceptance_note") @db.Text
  riskSecondReviewer     String?                        @map("risk_second_reviewer")
  riskSecondReviewerEmail String?                       @map("risk_second_reviewer_email")
  riskSecondReviewedAt   DateTime?                      @map("risk_second_reviewed_at")

  details Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  riskAssessments AiSystemRiskAssessment[]
  evidence        AiSystemEvidence[]
  changeLogs      AiSystemRegisterChangeLog[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([riskTier])
  @@index([nextReviewAt])
  @@index([riskAssessmentStatus])
  @@map("ai_system_register_items")
}

/// Field-level / action audit trail for a register system.
model AiSystemRegisterChangeLog {
  id             String   @id @default(cuid())
  systemId       String   @map("system_id")
  organizationId String   @map("organization_id")
  action         String
  summary        String
  field          String?
  oldValue       String?  @map("old_value") @db.Text
  newValue       String?  @map("new_value") @db.Text
  actorName      String?  @map("actor_name")
  actorEmail     String?  @map("actor_email")
  createdAt      DateTime @default(now()) @map("created_at")

  system AiSystemRegisterItem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([systemId, createdAt])
  @@index([organizationId])
  @@map("ai_system_register_change_logs")
}

model AiSystemRiskAssessment {
  id             String                      @id @default(cuid())
  systemId       String                      @map("system_id")
  organizationId String                      @map("organization_id")
  version        Int                         @default(1)
  status         AiSystemRiskAssessmentStatus @default(in_progress)
  factorScores   Json                        @map("factor_scores")
  inherentScore  Float?                      @map("inherent_score")
  residualScore  Float?                      @map("residual_score")
  inherentTier   RiskTier?                   @map("inherent_tier")
  residualTier   RiskTier?                   @map("residual_tier")
  hardRulesFired String[]                    @default([]) @map("hard_rules_fired")
  narrative      String?                     @db.Text
  assessorName   String?                     @map("assessor_name")
  completedAt    DateTime?                   @map("completed_at")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")

  system AiSystemRegisterItem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([systemId, version])
  @@index([systemId])
  @@index([organizationId])
  @@map("ai_system_risk_assessments")
}

model AiSystemEvidence {
  id                   String                 @id @default(cuid())
  systemId             String                 @map("system_id")
  organizationId       String                 @map("organization_id")
  evidenceType         AiRegisterEvidenceType @default(other) @map("evidence_type")
  title                String
  fileName             String?                @map("file_name")
  filePath             String?                @map("file_path")
  mimeType             String?                @map("mime_type")
  fileSize             Int?                   @map("file_size")
  externalUrl          String?                @map("external_url")
  notes                String?                @db.Text
  /// Optional link to a suite assessment type (e.g. privacy_dpia) for audit traceability.
  linkedAssessmentType String?                @map("linked_assessment_type")
  uploadedAt           DateTime               @default(now()) @map("uploaded_at")
  createdAt            DateTime               @default(now()) @map("created_at")

  system AiSystemRegisterItem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@index([systemId])
  @@index([organizationId])
  @@index([linkedAssessmentType])
  @@map("ai_system_evidence")
}
