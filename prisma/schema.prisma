/** Admin-assigned relative weight of a pillar within a pack (used in overall scoring). */
model QuestionPackPillarWeight {
  id        String   @id @default(cuid())
  packId    String   @map("pack_id")
  pillarId  String   @map("pillar_id")
  weight    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pack QuestionPack @relation(fields: [packId], references: [id], onDelete: Cascade)

