  pillarId  String   @map("pillar_id")
  prompt    String   @db.Text
  helpText  String?  @map("help_text") @db.Text
  /** Relative weight within the pillar (1–10). Higher = more influence on pillar score. */
  weight    Int      @default(1)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pack QuestionPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId, pillarId, sortOrder])
