enum QuestionPackPillarSet {
  standard_11
  tmt_6
}

enum PillarQuestionAnswer {
  yes
  no
  partial
  dont_know
}

model QuestionPack {
  id          String                 @id @default(cuid())
  name        String
  description String?                @db.Text
  product     QuestionPackProduct    @default(maturity_assessment)
  pillarSet   QuestionPackPillarSet  @default(standard_11) @map("pillar_set")
